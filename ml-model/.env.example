HOST=0.0.0.0
PORT=8000
# Database credentials used by the weekly forecast job are stored in GitHub Actions secrets
# in production. For local dev, point these at docker-compose.infra.yml's postgres service:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=epilink
# DB_USER=epilink
# DB_PASSWORD=epilink
# DATABASE_URL=postgresql://epilink:epilink@localhost:5432/epilink
# PGSSLMODE=disable
