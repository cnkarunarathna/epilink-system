# ===============================
# Root-level global ignore
# ===============================

# Node modules and logs (just in case)
node_modules/
*.log
*.tmp
.DS_Store

# Environment files (ignore all, except examples)
.env
.env.*
!.env.example

# Docker / Deployment
docker-data/
pgdata/
*.pid
*.sock
docker-compose.override.yml

# IDE / OS files
.vscode/
.idea/
Thumbs.db
Desktop.ini

# Reports / Exports (root level only; components/reports/ is needed for code)
/reports/
/docs/
*.pdf
*.xlsx
*.csv

# DOCS
python-service.txt
generate_weekly_forecast.txt