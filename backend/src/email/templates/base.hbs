<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Epilink Notification</title>
  <style>
    /* ── Reset ────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: #f0f4f8;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
                   'Helvetica Neue', Arial, sans-serif;
      color: #1a2332;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Outer wrapper ────────────────────────────────────── */
    .wrapper {
      width: 100%;
      padding: 36px 16px 48px;
      background-color: #f0f4f8;
    }

    /* ── Card ─────────────────────────────────────────────── */
    .container {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    /* ── Header ───────────────────────────────────────────── */
    .header {
      background: linear-gradient(135deg, #1b4f72 0%, #2e86c1 100%);
      padding: 28px 40px;
      text-align: center;
    }
    .header-logo {
      color: #ffffff;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .header-tagline {
      color: #aed6f1;
      font-size: 11px;
      margin-top: 4px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    /* ── Body ─────────────────────────────────────────────── */
    .body {
      padding: 40px;
    }

    /* ── Footer ───────────────────────────────────────────── */
    .footer {
      background: #f7fafc;
      padding: 24px 40px;
      border-top: 1px solid #e8edf2;
      text-align: center;
    }
    .footer p {
      font-size: 12px;
      color: #90a4ae;
      line-height: 1.6;
    }

    /* ── Typography ───────────────────────────────────────── */
    h1 {
      font-size: 22px;
      font-weight: 700;
      color: #1a2332;
      margin-bottom: 14px;
      line-height: 1.3;
    }
    h2 {
      font-size: 17px;
      font-weight: 600;
      color: #1a2332;
      margin-bottom: 10px;
    }
    p {
      font-size: 15px;
      line-height: 1.75;
      color: #455a64;
      margin-bottom: 16px;
    }
    p:last-child { margin-bottom: 0; }
    strong { color: #1a2332; }

    /* ── Button ───────────────────────────────────────────── */
    .btn-wrap { text-align: center; margin: 28px 0; }
    .btn {
      display: inline-block;
      padding: 13px 32px;
      background: #1b4f72;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    /* ── Status boxes ─────────────────────────────────────── */
    .info-box {
      background: #e8f4fd;
      border-left: 4px solid #2980b9;
      padding: 14px 18px;
      border-radius: 0 6px 6px 0;
      margin: 20px 0;
    }
    .info-box p { color: #1a5276; font-size: 14px; }

    .success-box {
      background: #eafaf1;
      border-left: 4px solid #27ae60;
      padding: 14px 18px;
      border-radius: 0 6px 6px 0;
      margin: 20px 0;
    }
    .success-box p { color: #1e8449; font-size: 14px; }

    .warning-box {
      background: #fef9e7;
      border-left: 4px solid #f39c12;
      padding: 14px 18px;
      border-radius: 0 6px 6px 0;
      margin: 20px 0;
    }
    .warning-box p { color: #7d6608; font-size: 14px; }

    .alert-box {
      background: #fdedec;
      border-left: 4px solid #e74c3c;
      padding: 14px 18px;
      border-radius: 0 6px 6px 0;
      margin: 20px 0;
    }
    .alert-box p { color: #922b21; font-size: 14px; }

    /* ── Detail list ──────────────────────────────────────── */
    .detail-list {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
      font-size: 14px;
    }
    .detail-list tr { border-bottom: 1px solid #eceff1; }
    .detail-list tr:last-child { border-bottom: none; }
    .detail-list td { padding: 9px 6px; color: #546e7a; vertical-align: top; }
    .detail-list td:first-child {
      font-weight: 600;
      color: #1a2332;
      width: 150px;
      white-space: nowrap;
    }

    /* ── Divider ──────────────────────────────────────────── */
    .divider {
      border: none;
      border-top: 1px solid #eceff1;
      margin: 28px 0;
    }

    /* ── Priority badges ──────────────────────────────────── */
    .badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-urgent  { background: #fdedec; color: #c0392b; }
    .badge-high    { background: #fef5e7; color: #d35400; }
    .badge-medium  { background: #fef9e7; color: #b7950b; }
    .badge-low     { background: #eafaf1; color: #1e8449; }

    /* ── Responsive ───────────────────────────────────────── */
    @media only screen and (max-width: 600px) {
      .body    { padding: 24px 20px; }
      .header  { padding: 22px 24px; }
      .footer  { padding: 18px 24px; }
      .detail-list td:first-child { width: 110px; }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      {{> header}}
      <div class="body">
        {{{content}}}
      </div>
      {{> footer}}
    </div>
  </div>
</body>
</html>
