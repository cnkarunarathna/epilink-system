<h1>Task Submitted for Review</h1>

<p>Hi {{supervisorName}},</p>

<p>
  A task in your district has been submitted for review. Please log in to review the evidence and verify or return the task.
</p>

<div class="info-box">
  <p>
    <strong>District:</strong> {{district}}
    &nbsp;&middot;&nbsp;
    <strong>Submitted by:</strong> {{phiName}}
  </p>
</div>

<hr class="divider" />

<h2>{{taskTitle}}</h2>

<table class="detail-list">
  <tr>
    <td>Type</td>
    <td>{{taskType}}</td>
  </tr>
  <tr>
    <td>Priority</td>
    <td><span class="badge-{{priority}}">{{uppercase priority}}</span></td>
  </tr>
  {{#if address}}
  <tr>
    <td>Address</td>
    <td>{{address}}</td>
  </tr>
  {{/if}}
  <tr>
    <td>Submitted At</td>
    <td>{{submittedAt}}</td>
  </tr>
</table>

{{#if taskUrl}}
<div class="btn-wrap">
  <a href="{{taskUrl}}" class="btn">Review Task</a>
</div>
{{/if}}

<p style="font-size: 13px; color: #90a4ae;">
  You are receiving this because you are the supervisor for the {{district}} district.
</p>
