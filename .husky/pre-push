#!/bin/sh

echo "Running pre-push syntax checks..."

# Run frontend lint (syntax check only)
echo "Checking frontend syntax..."
cd frontend && npm run lint || {
  echo "Frontend syntax check failed! Push aborted."
  exit 1
}
cd ..

# Run backend lint (syntax check only)
echo "Checking backend syntax..."
cd backend && npm run lint || {
  echo "Backend syntax check failed! Push aborted."
  exit 1
}
cd ..

echo "All pre-push syntax checks passed!"
